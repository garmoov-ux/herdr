# ==============================================================================
# Herdr × Hermes Multi-Messenger Gateway Configuration (.env)
# ==============================================================================
# Copy this file to `.env` in the repository root (`cp .env.example .env`)
# and fill in at least ONE messenger section below (Telegram, Slack, or Discord).
# You can enable one, two, or all three simultaneously!
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. Telegram Bot Configuration (양방향 제어 + 인라인 버튼 + 실시간 알림)
# ------------------------------------------------------------------------------
# [발급 방법 / How to get]
# 1) 텔레그램에서 @BotFather 를 검색해 대화 시작
# 2) `/newbot` 입력 -> 봇 이름 및 아이디(`..._bot`) 입력 후 발급된 HTTP API 토큰 복사
# 3) (선택) 본인만 제어하도록 제한하려면 @userinfobot 등을 통해 확인한 본인의 숫자 Chat ID를
#    TELEGRAM_ALLOWED_CHAT_ID 에 입력하세요. (비워두면 봇에게 첫 메시지를 보낸 채팅방에 자동 연결됩니다.)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_ALLOWED_CHAT_ID=


# ------------------------------------------------------------------------------
# 2. Slack Bot Configuration (채널 명령어 + 스레드 답장 라우팅 + 실시간 알림)
# ------------------------------------------------------------------------------
# [발급 방법 / How to get]
# 1) https://api.slack.com/apps 접속 -> "Create New App" -> "From scratch" 선택
# 2) 좌측 메뉴 "OAuth & Permissions" -> "Bot Token Scopes" 에 아래 권한 추가:
#    - `chat:write` (알림 및 응답 메시지 전송)
#    - `channels:history` / `groups:history` (채널 명령어 및 스레드 답장 읽기)
# 3) 상단 "Install to Workspace" 클릭 후 발급된 `xoxb-...` 토큰을 SLACK_BOT_TOKEN 에 입력
# 4) 슬랙에서 봇을 원하는 채널에 초대(`/invite @봇이름`)한 뒤,
#    채널 이름 클릭 -> 하단에서 복사한 채널 ID(`C0123456789` 형태)를 SLACK_CHANNEL_ID 에 입력
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=


# ------------------------------------------------------------------------------
# 3. Discord Bot / Webhook Configuration (양방향 명령어·답장 제어 또는 웹훅 알림)
# ------------------------------------------------------------------------------
# [발급 방법 A: 양방향 봇 제어 (권장)]
# 1) https://discord.com/developers/applications 접속 -> "New Application" 생성
# 2) 좌측 "Bot" 메뉴 -> "Reset Token" 으로 발급받은 토큰을 DISCORD_BOT_TOKEN 에 입력
#    - 아래 "Privileged Gateway Intents" 에서 **Message Content Intent** 를 반드시 활성화(ON)하세요!
# 3) 좌측 "OAuth2" -> "URL Generator" 에서 Scopes: `bot`, Bot Permissions:
#    `View Channels`, `Send Messages`, `Read Message History` 체크 후 생성된 URL로 서버에 봇 초대
# 4) 디스코드 설정 -> 고급 -> "개발자 모드" 켜기 -> 제어할 텍스트 채널 우클릭 -> "채널 ID 복사" 후
#    DISCORD_CHANNEL_ID 에 입력
#
# [발급 방법 B: 단방향 웹훅 알림 전용 (선택)]
# - 봇 생성 없이 알림만 받으려면 디스코드 채널 설정 -> 연동(Integrations) -> 웹후크(Webhooks) 생성 후
#   URL을 DISCORD_WEBHOOK_URL 에 입력하세요.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_WEBHOOK_URL=
